# ---------------------------------------------------------------------------
# Public variables (embedded in the browser bundle => NEVER put secrets here)
# ---------------------------------------------------------------------------
# Render backend base URL (no trailing slash). Required in production.
# Do not leave this empty in production: there is no LocalStorage fallback there.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase project (publishable/anon key is safe to expose; RLS is read-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy projects may use the anon key name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Keep "true" in production. "false" bypasses the login gate for local work.
NEXT_PUBLIC_AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Server-only variables (Set these in Render. NEVER prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Prefer the newer secret key name; the service-role key name is also supported.
SUPABASE_SECRET_KEY=your-secret-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of allowed browser origins (Cloudflare Pages + localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Ignored in production: the API always requires a valid Supabase JWT there.
AUTH_REQUIRED=true

# Local backend port (Render provides PORT automatically)
PORT=8787
