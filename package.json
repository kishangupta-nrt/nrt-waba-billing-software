{
  "name": "waba-billing-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:server": "tsx watch server/src/index.ts",
    "build:server": "tsup server/src/index.ts --format cjs --platform node --target node20 --out-dir server/dist --clean",
    "start:server": "node server/dist/index.js",
    "deploy:frontend": "wrangler deploy"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.33"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@supabase/supabase-js": "^2.46.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.29",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "serve": "14.2.4",
    "tailwindcss": "^3.4.15",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "3.2.4",
    "wrangler": "3.99.0"
  }
}
